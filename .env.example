# --- LLM (any OpenAI-compatible API). Default: Groq free tier — key at https://console.groq.com/keys
# Without a key the service still works: review summaries fall back to an extractive algorithm.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
# Alternatives (also free):
#   Google Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-2.5-flash-lite
#   OpenRouter:     LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Speech-to-text for let's plays without YouTube captions (defaults to the LLM key / Groq Whisper)
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo
STT_MAX_MINUTES=15

# --- Service
PORT=3000
RUN_CRON=0 * * * *
RUN_ON_STARTUP=true
GAMES_PER_RUN=20
# auto = direct JSON API, falls back to a Playwright browser if blocked; http | browser to force one
MC_FETCH_MODE=auto
LETSPLAY_ENABLED=true
