{
  "name": "metacritic-service",
  "version": "1.0.0",
  "description": "Hourly Metacritic games crawler with AI review summaries, let's play digests and a live-monitoring web UI",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "tsx watch src/server.tsx",
    "start": "tsx src/server.tsx",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "test:e2e": "playwright test",
    "export-chats": "node scripts/export-chats.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "openai": "^7.34.0",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  }
}
